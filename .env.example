# ==============================================================================
# TripDesk — Production & Development Environment Variable Template
# ==============================================================================
# NOTE: Never commit actual secret keys or credentials to version control.
# Copy this file to .env or .env.local and configure your environment-specific values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Transaction Pooler connection string (Port 6543, pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (Port 5432) for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase project URL (Public, safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Supabase Anonymous Public API Key (Public, safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SERVER-ONLY SECRET — NEVER expose to browser)
# Used exclusively by server-side bootstrap and administrative tasks
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. APPLICATION & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
# Environment mode: 'production' | 'development' | 'test'
NODE_ENV="production"

# Public canonical URL for the TripDesk web application (used for email links, public tokens)
NEXT_PUBLIC_APP_URL="https://app.tripdesk.io"

# ------------------------------------------------------------------------------
# 4. BACKGROUND AUTOMATION & WEBHOOK SECRETS
# ------------------------------------------------------------------------------
# Secret token required to trigger server-side cron automation sweeps (/api/communication/automation/run)
CRON_SECRET="your-high-entropy-random-cron-secret-32-chars-min"

# Shared secret for validating incoming communication delivery webhooks (/api/webhooks/communication)
COMMUNICATION_WEBHOOK_SECRET="your-webhook-verification-signing-secret"

# ------------------------------------------------------------------------------
# 5. COMMUNICATION PROVIDERS (Optional / Configurable per Agency or Platform)
# ------------------------------------------------------------------------------
# Outbound SMTP Mail Configuration (Fallback / Default system mailer)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="re_your_api_key_here"
SMTP_FROM="TripDesk Notifications <notifications@tripdesk.io>"

# WhatsApp Cloud API Configuration (Meta Graph API)
WHATSAPP_API_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="100000000000000"
WHATSAPP_BUSINESS_ACCOUNT_ID="200000000000000"

# ------------------------------------------------------------------------------
# 6. PLATFORM OWNER INITIAL BOOTSTRAP (For 'npm run bootstrap:owner')
# ------------------------------------------------------------------------------
# Credentials used solely by prisma/bootstrap-owner.ts to initialize the initial Platform Owner
BOOTSTRAP_OWNER_EMAIL="owner@tripdesk.io"
BOOTSTRAP_OWNER_PASSWORD="ChangeMeTripDesk2026!"
BOOTSTRAP_OWNER_NAME="TripDesk Platform Owner"
