{
  "name": "tripdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "bootstrap:owner": "tsx prisma/bootstrap-owner.ts",
    "bootstrap:owner:staging": "tsx --env-file=.env.staging prisma/bootstrap-owner.ts",
    "bootstrap:agency-owner": "tsx prisma/bootstrap-agency-owner.ts",
    "prisma:status:staging": "node --env-file=.env.staging node_modules/prisma/build/index.js migrate status",
    "prisma:migrate:staging": "node --env-file=.env.staging node_modules/prisma/build/index.js migrate deploy",
    "prisma:seed:staging": "tsx --env-file=.env.staging prisma/seed.ts",
    "repair:catalog:production": "tsx --env-file=.env.production prisma/repair-subscription-catalog.ts",
    "test:catalog:repair": "tsx prisma/test-catalog-repair.ts",
    "test:subscription:ux": "tsx prisma/test-subscription-trial-ux.ts",
    "test:support:contacts": "tsx prisma/test-support-contacts.ts",
    "test:crm:correctness": "tsx prisma/test-crm-correctness.ts",
    "test:crm:drag-drop": "tsx prisma/test-crm-drag-drop.ts",
    "test:itinerary:correctness": "tsx prisma/test-itinerary-correctness.ts",
    "test:itinerary:drag-drop": "tsx prisma/test-itinerary-drag-drop.ts",
    "test:staff:session": "tsx prisma/test-staff-invitation-session.ts",
    "test:dashboard:auth": "tsx prisma/test-staff-dashboard-authorization.ts",
    "backfill:booking-enquiries": "tsx scripts/backfill-booking-enquiries.ts",
    "test:staff:app-wide": "tsx prisma/test-staff-application-wide-authorization.ts",
    "test:staff:failures": "tsx prisma/test-staff-failures-phase1.ts",
    "test:e2e:integration": "tsx prisma/test-crm-itinerary-e2e-integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@types/pdfkit": "^0.17.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formik": "^2.4.9",
    "lucide-react": "^1.33.0",
    "next": "16.4.6",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
